# 仅供本地开发：复制为 .env 后填入你自己轮换后的私有凭据（.env 已被 .gitignore 忽略，切勿提交）
# 两种方式任选其一即可；也可以都不填，直接在页面「API 设置」里临时输入（只保存在内存）。
TENCENTCLOUD_WSA_APIKEY=REPLACE_WITH_NEW_PRIVATE_KEY
TENCENTCLOUD_SECRET_ID=REPLACE_WITH_NEW_PRIVATE_SECRET_ID
TENCENTCLOUD_SECRET_KEY=REPLACE_WITH_NEW_PRIVATE_SECRET_KEY
# 设为 1 才允许页面使用上面的环境变量凭据（默认关闭）
CODEFRESH_ALLOW_ENV_CREDENTIALS=0
